{
  "name": "evalme-mvp-cli",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Evidence-based personal practice CLI with SQLite and PostgreSQL",
  "bin": {
    "evalme-mvp": "src/cli.mjs"
  },
  "engines": {
    "node": ">=22.16.0 <23 || >=24.0.0 <25"
  },
  "files": [
    "src",
    "skills",
    "scripts",
    "README.md",
    "DEPLOYMENT.md",
    "ACCEPTANCE.md",
    "evidence",
    "npm-shrinkwrap.json",
    "INSTALLATION-ACCEPTANCE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:cli": "node --test tests/cli.test.mjs",
    "test:pg": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "pg": "8.16.3"
  }
}
